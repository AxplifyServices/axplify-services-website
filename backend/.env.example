# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api

# =========================================================
# FRONTEND ET CORS
# =========================================================

FRONTEND_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# =========================================================
# POSTGRESQL LOCAL WINDOWS
# =========================================================

DATABASE_URL=postgresql://postgres:1234@localhost:5432/axplify_db?schema=public

# =========================================================
# AUTHENTIFICATION
# Valeurs temporaires pour le développement local
# =========================================================

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# =========================================================
# MINIO LOCAL
# =========================================================

MINIO_ENDPOINT=localhost
MINIO_PORT=9200
MINIO_USE_SSL=false

MINIO_ACCESS_KEY=axplify_minio_admin
MINIO_SECRET_KEY=axplify_minio_local_password_change_me

MINIO_PUBLIC_BUCKET=axplify-public
MINIO_PRIVATE_BUCKET=axplify-private

MINIO_PUBLIC_URL=http://localhost:9200/axplify-public

# =========================================================
# UPLOADS
# =========================================================

UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760
UPLOAD_MAX_DOCUMENT_SIZE_BYTES=26214400

UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif
UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

UPLOAD_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
UPLOAD_MAX_VIDEO_SIZE_BYTES=104857600

# =========================================================
# NOTIFICATIONS TELEGRAM
# =========================================================

TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=8648205346:AAHg8LLnPHP4fzyyXPvM9saXsdwzM2fxn10
TELEGRAM_CHAT_ID=5826485949